+    const a = pts[closed ? (k - 1 + pts.length) % pts.length : Math.max(0, k - 1)];
+    const b = pts[closed ? (k + 1) % pts.length : Math.min(pts.length - 1, k + 1)];
+    const L = Math.hypot(b.x - a.x, b.z - a.z) || 1;
