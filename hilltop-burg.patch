+
+/** Nearest point on a sampled path: { d, x, z, s, i, t, tx, tz } (i = segment start). */
+export function nearestOnPath(path, x, z) {
+  const P = path.pts, last = path.closed ? P.length : P.length - 1;
+  let best = { d: Infinity };
